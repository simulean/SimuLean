sysinfo.txt

# Builds
*.apk
*.unitypackage
# Ignore plugin binaries
*.dll
*.dll.meta
Assets/Plugins.meta

# Paper-experiment generated scripts (local only, not tracked)
Assets/PaperExperiments/
Assets/PaperExperiments.meta

# LaTeX paper files (kept locally, not in repo)
PROCS_I3M 2025.*

# Python tooling (Tools/*)
__pycache__/
*.pyc
# Blender asset pipeline: preview renders are regenerated by each script (Tools/Blender/README.md)
Tools/Blender/previews/
# Floor-plan pipeline (Tools/FloorPlan/README.md): third-party converter, venv, drawings and outputs stay local
Tools/LibreDWG/
Tools/FloorPlan/.venv/
Tools/FloorPlan/work/

# Claude Code test-gate hook state
.claude/hooks/.state/

# EditMode tests: temporary copy of a scene that is open in the editor (IsolatedScene)
/Assets/__SimuLeanTestScene__.unity
/Assets/__SimuLeanTestScene__.unity.meta

# SimuLean outputs written in the project folder (recorder takes, project database, results)
/Recordings/
/SimuLeanData/
/SimuLeanResults/
