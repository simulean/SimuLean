<!-- The engine fingerprint computed when a project is built: the same algorithm as
     SimuLean.Serialization.EngineFingerprint.OfSources (SHA-256 of every *.cs under the engine folder, ordinal by relative
     path with '/', carriage returns removed, then the choice rules' sources under UserLogicRoot as UserLogic/<path>;
     first 16 hex digits), written as the constant EngineBuild.Fingerprint.
     runnertests checks that both agree. Import after Engine.props (it uses EngineRoot). -->
<Project>
  <UsingTask TaskName="SimuLeanEngineFingerprint" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Root ParameterType="System.String" Required="true" />
      <UserLogicRoot ParameterType="System.String" Required="false" />
      <Fingerprint ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Security.Cryptography" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string root = Path.GetFullPath(Root).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        var files = Directory.GetFiles(root, "*.cs", SearchOption.AllDirectories)
            .Select(f => new { rel = f.Substring(root.Length + 1).Replace(Path.DirectorySeparatorChar, '/'), full = f })
            .OrderBy(f => f.rel, StringComparer.Ordinal).ToList();
        if (!string.IsNullOrEmpty(UserLogicRoot) && Directory.Exists(UserLogicRoot))
        {
            string ul = Path.GetFullPath(UserLogicRoot).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
            files.AddRange(Directory.GetFiles(ul, "*.cs", SearchOption.AllDirectories)
                .Select(f => new { rel = "UserLogic/" + f.Substring(ul.Length + 1).Replace(Path.DirectorySeparatorChar, '/'), full = f })
                .OrderBy(f => f.rel, StringComparer.Ordinal));
        }
        using (var sha = SHA256.Create())
        {
            foreach (var f in files)
            {
                string text = File.ReadAllText(f.full, Encoding.UTF8).Replace("\r", "");
                byte[] bytes = Encoding.UTF8.GetBytes(f.rel + "\n" + text + "\n");
                sha.TransformBlock(bytes, 0, bytes.Length, null, 0);
            }
            sha.TransformFinalBlock(new byte[0], 0, 0);
            Fingerprint = string.Concat(sha.Hash.Take(8).Select(b => b.ToString("x2")));
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="SimuLeanWriteFingerprint" BeforeTargets="CoreCompile">
    <SimuLeanEngineFingerprint Root="$(EngineRoot)" UserLogicRoot="$(UserLogicRoot)">
      <Output TaskParameter="Fingerprint" PropertyName="SimuLeanFingerprint" />
    </SimuLeanEngineFingerprint>
    <PropertyGroup>
      <SimuLeanFingerprintFile>$(IntermediateOutputPath)EngineBuild.g.cs</SimuLeanFingerprintFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(SimuLeanFingerprintFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// generated by Tools/Runner/Fingerprint.targets;internal static class EngineBuild { public const string Fingerprint = &quot;$(SimuLeanFingerprint)&quot;%3B }" />
    <ItemGroup>
      <Compile Include="$(SimuLeanFingerprintFile)" />
    </ItemGroup>
  </Target>
</Project>
