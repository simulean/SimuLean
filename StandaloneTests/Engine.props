<!-- Shared build items: compiles every source of Assets/SimuLean.Net outside Unity. The engine
     is its own assembly with no UnityEngine reference (SimuLean.Net.asmdef), so nothing needs stubbing.
     Import it from a test csproj: <Import Project="..\Engine.props" /> -->
<Project>
  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- .NET 10 LTS (.NET 8 support ends 2026-11-10): the runner's runtime. The C# version is Unity's
         (C# 9, Unity 6.6), so code that compiles here but not in the editor cannot get into the engine. -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EngineRoot>$(MSBuildThisFileDirectory)..\Assets\SimuLean.Net</EngineRoot>
    <!-- the choice rules (assembly SimuLean.UserLogic in Unity): compiled with the engine here and in the
         runner, so a headless run outside the editor has them; the runner's fingerprint covers them -->
    <UserLogicRoot>$(MSBuildThisFileDirectory)..\Assets\SimuLean.UserLogic</UserLogicRoot>
    <NoWarn>$(NoWarn);CS8632;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(EngineRoot)\**\*.cs" />
    <Compile Include="$(UserLogicRoot)\**\*.cs" Condition="Exists('$(UserLogicRoot)')" />
  </ItemGroup>
</Project>
